<UserControl x:Class="Rasid.Pages.Projects.ProjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}" Margin="16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Projects" Style="{StaticResource RasidPageTitleStyle}"/>
            <Button Grid.Column="1"
                    Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Padding="12,5"/>
        </Grid>

        <TextBlock Grid.Row="1"
                   Text="Open a project to view its processes and results."
                   Foreground="{StaticResource RasidMutedTextBrush}"
                   FontSize="11"
                   Margin="0,3,0,12"/>

        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Projects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource RasidCardBorderStyle}"
                                    Width="300"
                                    Margin="0,0,10,10"
                                    Padding="0">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="170"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <Border Background="{StaticResource RasidPrimarySoftBrush}"
                                            CornerRadius="5,5,0,0"
                                            ClipToBounds="True">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}"
                                                   Stretch="UniformToFill"/>
                                            <TextBlock Text="No preview"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource RasidMutedTextBrush}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="14,12,14,14">
                                        <TextBlock Text="{Binding Project.Title}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource RasidTextBrush}"/>

                                        <Border Background="{StaticResource RasidPrimaryBrush}"
                                                CornerRadius="4"
                                                HorizontalAlignment="Left"
                                                Padding="9,4"
                                                Margin="0,8,0,0">
                                            <TextBlock Text="{Binding Project.Solution.Name}"
                                                       Foreground="White"
                                                       FontSize="10"/>
                                        </Border>

                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,12">
                                            <TextBlock Text="{Binding ModifiedDateText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource RasidMutedTextBrush}"/>
                                            <TextBlock Text="  •  "
                                                       FontSize="10"
                                                       Foreground="{StaticResource RasidMutedTextBrush}"/>
                                            <TextBlock Text="{Binding ProcessesText}"
                                                       FontSize="10"
                                                       Foreground="{StaticResource RasidMutedTextBrush}"/>
                                        </StackPanel>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="8"/>
                                                <ColumnDefinition Width="40"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Content="Open Project"
                                                    Command="{Binding OpenCommand}"
                                                    Style="{StaticResource RasidPrimaryButtonStyle}"
                                                    Padding="16,7"/>
                                            <Button Grid.Column="2"
                                                    Command="{Binding HideCommand}"
                                                    Style="{StaticResource RasidSecondaryButtonStyle}"
                                                    Foreground="{StaticResource RasidDangerBrush}"
                                                    FontFamily="Segoe MDL2 Assets"
                                                    FontSize="14"
                                                    Content="&#xE74D;"
                                                    Padding="0"
                                                    ToolTip="Hide project"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock Text="{Binding StatusText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       Visibility="{Binding StatusText, Converter={StaticResource StringToVisibilityConverter}}"/>
        </Grid>
    </Grid>
</UserControl>
