<UserControl x:Class="Rasid.Pages.GoPilot.GoPilotView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shared="clr-namespace:Rasid.Pages.Shared">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Chat history, matching the middle column in the desktop RASID app. -->
        <Border Grid.Column="0"
                Background="#FBFCFC"
                BorderBrush="{StaticResource RasidBorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Text="Chat History"
                           Style="{StaticResource RasidSectionTitleStyle}"
                           Margin="1,2,0,8"/>

                <Button Grid.Row="1"
                        Content="+  New Chat"
                        Command="{Binding NewChatCommand}"
                        Style="{StaticResource RasidPrimaryButtonStyle}"
                        Padding="10,6"
                        Margin="0,0,0,8"/>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Sessions}"
                         SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                         BorderThickness="0"
                         Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding"
                                    Value="0"/>
                            <Setter Property="Margin"
                                    Value="0,0,0,3"/>
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch"/>
                            <Setter Property="Background"
                                    Value="Transparent"/>
                            <Setter Property="BorderThickness"
                                    Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Root"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4"
                                                Padding="8,7">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                    Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="#EEF3F4"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected"
                                                    Value="True">
                                                <Setter TargetName="Root"
                                                        Property="Background"
                                                        Value="{StaticResource RasidPrimarySoftBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Title}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource RasidTextBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           ToolTip="{Binding Title}"/>
                                <Button Grid.Column="1"
                                        Content="&#x2715;"
                                        Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        ToolTip="Delete chat"
                                        Width="22"
                                        Height="22"
                                        Padding="0"
                                        Margin="5,0,0,0"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Foreground="{StaticResource RasidDangerBrush}"
                                        Cursor="Hand"
                                        Focusable="False"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <TextBlock Grid.Row="3"
                           Text="{Binding HistoryStatus}"
                           FontSize="10"
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           TextWrapping="Wrap"
                           Margin="2,6,2,0"/>
            </Grid>
        </Border>

        <!-- Main GoPilot workspace. -->
        <Grid Grid.Column="1"
                Margin="12,10,12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="2,0,2,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GoPilot"
                            Style="{StaticResource RasidPageTitleStyle}"/>

                </StackPanel>
                <TextBlock Grid.Column="1"
                           Text="{Binding StatusText}"
                           FontSize="10"
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           VerticalAlignment="Top"
                           Margin="8,5,0,0"/>
            </Grid>

            <Border Grid.Row="1"
                    Style="{StaticResource RasidCardBorderStyle}"
                    Background="#FAFBFB"
                    Padding="12">
                <Grid>
                    <ScrollViewer x:Name="ChatScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly"
                                  Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Bubble"
                                            MaxWidth="520"
                                            Margin="2,4"
                                            Padding="10,7"
                                            CornerRadius="5"
                                            Background="#EEF1F2"
                                            HorizontalAlignment="Left">
                                        <StackPanel>
                                            <shared:MarkdownViewer x:Name="MessageText"
                                                                   Markdown="{Binding Text}"
                                                                   Foreground="{StaticResource RasidTextBrush}"
                                                                   FontSize="11.5"/>

                                            <!-- File controls are always grouped at the end of the reply. -->
                                            <ItemsControl ItemsSource="{Binding Files}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Margin="0,8,0,0">
                                                            <Border Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}"
                                                                    Background="#F5F7F8"
                                                                    BorderBrush="{StaticResource RasidBorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="4"
                                                                    Padding="5"
                                                                    MaxWidth="420">
                                                                <StackPanel>
                                                                    <Image Source="{Binding Preview}"
                                                                           MaxHeight="220"
                                                                           Stretch="Uniform"/>
                                                                    <TextBlock Text="{Binding PreviewStatus}"
                                                                               Foreground="{StaticResource RasidMutedTextBrush}"
                                                                               FontSize="10"
                                                                               TextAlignment="Center"
                                                                               TextWrapping="Wrap"
                                                                               Margin="4"/>
                                                                </StackPanel>
                                                            </Border>

                                                            <Button Content="{Binding ActionText}"
                                                                    Command="{Binding DataContext.DownloadFileCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                                                    CommandParameter="{Binding}"
                                                                    IsEnabled="{Binding IsActionEnabled}"
                                                                    Style="{StaticResource RasidSecondaryButtonStyle}"
                                                                    HorizontalAlignment="Left"
                                                                    Padding="9,5"
                                                                    Margin="0,5,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <TextBlock x:Name="MessageTimestamp"
                                                       Text="{Binding TimestampText}"
                                                       HorizontalAlignment="Left"
                                                       Foreground="{StaticResource RasidMutedTextBrush}"
                                                       FontSize="9"
                                                       Margin="0,4,0,0"/>
                                        </StackPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Role}"
                                                Value="user">
                                            <Setter TargetName="Bubble"
                                                    Property="Background"
                                                    Value="{StaticResource RasidPrimaryBrush}"/>
                                            <Setter TargetName="Bubble"
                                                    Property="HorizontalAlignment"
                                                    Value="Right"/>
                                            <Setter TargetName="MessageText"
                                                    Property="Foreground"
                                                    Value="White"/>
                                            <Setter TargetName="MessageTimestamp"
                                                    Property="HorizontalAlignment"
                                                    Value="Right"/>
                                            <Setter TargetName="MessageTimestamp"
                                                    Property="Foreground"
                                                    Value="White"/>
                                            <Setter TargetName="MessageTimestamp"
                                                    Property="Opacity"
                                                    Value="0.75"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsPending}"
                                                Value="True">
                                            <Setter TargetName="MessageText"
                                                    Property="Markdown"
                                                    Value="Thinking..."/>
                                            <Setter TargetName="MessageText"
                                                    Property="FontStyle"
                                                    Value="Italic"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="390"
                                Visibility="{Binding HasMessages, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                        <TextBlock Text="&#x1F44B;  Welcome to GoPilot"
                                   FontSize="17"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource RasidTextBrush}"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Your geospatial intelligence co-pilot. Ask me about satellite imagery, Earth observation, spatial analysis, or ArcGIS Pro operations."
                                   FontSize="11"
                                   Foreground="{StaticResource RasidMutedTextBrush}"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2"
                    Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="&#x270E;"
                        Command="{Binding DrawCommand}"
                        ToolTip="Draw an area on the map">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource RasidIconButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDrawActive}"
                                        Value="True">
                                    <Setter Property="Background"
                                            Value="{StaticResource RasidPrimaryBrush}"/>
                                    <Setter Property="Foreground"
                                            Value="White"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Grid.Column="1"
                        Content="&#x25B3;"
                        Command="{Binding PickLayerCommand}"
                        ToolTip="Attach a layer from the map"
                        Style="{StaticResource RasidIconButtonStyle}"
                        Margin="5,0,0,0"/>

                <TextBox Grid.Column="2"
                         Text="{Binding DraftText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RasidTextBoxStyle}"
                         Margin="7,0"
                         MinHeight="38"
                         MaxHeight="86"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         ToolTip="Write a message to GoPilot"/>

                <Button Grid.Column="3"
                        Content="Send"
                        Command="{Binding SendCommand}"
                        IsEnabled="{Binding CanSend}"
                        Style="{StaticResource RasidPrimaryButtonStyle}"
                        MinWidth="72"/>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

