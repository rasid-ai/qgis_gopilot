<UserControl x:Class="Rasid.Pages.Login.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#173C40">
            <StackPanel VerticalAlignment="Center" Margin="30">
                <Image Source="/RASID;component/Images/icon_nobg.png" Height="90" Stretch="Uniform"/>
                <TextBlock Text="Welcome Back"
                           FontSize="25"
                           FontWeight="SemiBold"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           Margin="0,18,0,0"/>
                <TextBlock Text="Access your geospatial solutions and manage RASID projects directly inside ArcGIS Pro."
                           Foreground="#DCEBEC"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           Margin="0,10,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Grid.Column="1" Margin="48,36" VerticalAlignment="Center" MaxWidth="420">
            <TextBlock Text="Connect to RASID" Style="{StaticResource RasidPageTitleStyle}"/>
            <TextBlock Text="Enter your API key to continue."
                       Margin="0,4,0,20"
                       Foreground="{StaticResource RasidMutedTextBrush}"/>

            <TextBlock Text="API Key" Style="{StaticResource RasidSectionTitleStyle}"/>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <PasswordBox x:Name="ApiKeyPasswordBox"
                             Grid.Column="0"
                             Style="{StaticResource RasidPasswordBoxStyle}"
                             PasswordChanged="ApiKeyPasswordBox_OnPasswordChanged"
                             Visibility="{Binding IsKeyVisible, Converter={StaticResource InverseBoolToVisibilityConverter}}"/>
                <TextBox Grid.Column="0"
                         Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource RasidTextBoxStyle}"
                         Visibility="{Binding IsKeyVisible, Converter={StaticResource BoolToVis}}"/>
                <Button Grid.Column="1"
                        Content="👁"
                        Width="42"
                        Margin="5,0,0,0"
                        Command="{Binding ToggleVisibilityCommand}"
                        Style="{StaticResource RasidSecondaryButtonStyle}"/>
            </Grid>

            <Button Content="Connect"
                    Command="{Binding ConnectCommand}"
                    Margin="0,16,0,0"
                    Style="{StaticResource RasidPrimaryButtonStyle}"/>
            <Button Content="Get API Key"
                    Command="{Binding GetApiKeyCommand}"
                    Margin="0,8,0,0"
                    Style="{StaticResource RasidSecondaryButtonStyle}"/>

            <TextBlock Text="{Binding ErrorText}"
                       Foreground="{StaticResource RasidDangerBrush}"
                       Margin="0,10,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding ErrorText, Converter={StaticResource StringToVisibilityConverter}}"/>

            <TextBlock Margin="0,18,0,0" HorizontalAlignment="Center" Foreground="{StaticResource RasidMutedTextBrush}">
                <Run Text="Don't have an account? "/>
                <Hyperlink Command="{Binding SignUpCommand}" Foreground="{StaticResource RasidPrimaryBrush}">
                    <Run Text="Sign up"/>
                </Hyperlink>
            </TextBlock>
        </StackPanel>
    </Grid>
</UserControl>
