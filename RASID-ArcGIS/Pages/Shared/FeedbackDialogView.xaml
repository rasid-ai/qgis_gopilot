<Window x:Class="Rasid.Pages.Shared.FeedbackDialogView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Feedback"
        Width="476"
        Height="384"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource RasidBackgroundBrush}">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
			</ResourceDictionary.MergedDictionaries>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="18">
		<Border Style="{StaticResource RasidCardBorderStyle}" Padding="20">
			<StackPanel>
				<TextBlock Text="Provide Feedback"
                           Style="{StaticResource RasidPageTitleStyle}"
                           HorizontalAlignment="Center"/>
				<TextBlock Text="We value your input and use it to improve RASID."
                           HorizontalAlignment="Center"
                           Foreground="{StaticResource RasidMutedTextBrush}"
                           Margin="0,4,0,5"/>

				<TextBlock Text="How would you rate your experience?" Style="{StaticResource RasidSectionTitleStyle}"/>
				<ItemsControl ItemsSource="{Binding Stars}" Margin="0,6,0,0">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<StackPanel Orientation="Horizontal"/>
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>
					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Button Content="{Binding IsFilled, Converter={StaticResource StarGlyphConverter}}"
                                    Command="{Binding SetRatingCommand}"
                                    Width="40"
                                    Height="40"
                                    FontSize="24"
                                    Foreground="#E1A326"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Cursor="Hand"/>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>

				<TextBlock Text="Your message" Style="{StaticResource RasidSectionTitleStyle}" Margin="0,5,0,4"/>
				<TextBox Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True"
                         MinHeight="80"
                         MaxHeight="140"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource RasidTextBoxStyle}" TextChanged="TextBox_TextChanged"/>

				<Button Content="Submit Feedback"
                        Command="{Binding SubmitCommand}"
                        Style="{StaticResource RasidPrimaryButtonStyle}"
                        Margin="0,16,0,0"/>
			</StackPanel>
		</Border>
	</Grid>
</Window>
