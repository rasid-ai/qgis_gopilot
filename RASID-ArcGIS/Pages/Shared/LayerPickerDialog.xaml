<Window x:Class="Rasid.Pages.Shared.LayerPickerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Select Layer"
        Height="410"
        Width="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/RASID;component/Resources/SharedResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{StaticResource RasidBackgroundBrush}" Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,8">
            <TextBlock Text="Select AOI Layer" Style="{StaticResource RasidPageTitleStyle}"/>
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource RasidMutedTextBrush}"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Margin="0,3,0,0"/>
        </StackPanel>

        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Layers}"
                 DisplayMemberPath="Name"
                 SelectedItem="{Binding SelectedLayer, Mode=TwoWay}"
                 BorderBrush="{StaticResource RasidBorderBrush}"
                 Background="White"
                 Padding="4"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Refresh"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Cancel"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource RasidSecondaryButtonStyle}"
                    Margin="0,0,8,0"/>
            <Button Content="Use Layer"
                    IsDefault="True"
                    IsEnabled="{Binding HasSelection}"
                    Click="Ok_Click"
                    Style="{StaticResource RasidPrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
