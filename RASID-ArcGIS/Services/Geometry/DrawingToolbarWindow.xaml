<Window x:Class="Rasid.Services.Geometry.DrawingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight">
	<Window.Resources>
		<Style x:Key="DrawActionButton" TargetType="Button">
			<Setter Property="Height" Value="43"/>
			<Setter Property="Margin" Value="0,0,0,10"/>
			<Setter Property="Foreground" Value="White"/>
			<Setter Property="Background" Value="#162535"/>
			<Setter Property="BorderBrush" Value="#718092"/>
			<Setter Property="BorderThickness" Value="1"/>
			<Setter Property="HorizontalContentAlignment" Value="Left"/>
			<Setter Property="Padding" Value="16,0"/>
			<Setter Property="FontSize" Value="13"/>
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
							<ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.86"/>
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="ButtonBorder" Property="Opacity" Value="0.36"/>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</Window.Resources>

	<Border Width="217"
            Padding="30,24,30,20"
            CornerRadius="14"
            BorderBrush="#506579"
            BorderThickness="1">
		<Border.Background>
			<LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
				<GradientStop Color="#F2253B50" Offset="0"/>
				<GradientStop Color="#F0142638" Offset="1"/>
			</LinearGradientBrush>
		</Border.Background>

		<StackPanel>

			<TextBlock Text="✏  Drawing Mode"
                       FontWeight="Bold"
                       Foreground="White"
                       FontSize="15"
                       />

			<TextBlock Text="{Binding InfoText}"
                       Foreground="#BFD0DAE4"
                       FontSize="10"
                       LineHeight="19"
                       Margin="2,0,2,12"
                       TextWrapping="Wrap"/>
			<Border Height="1" Background="#53677A" Margin="0,0,0,12"/>

			<Button Content="♧  Undo Last Point"
                    Command="{Binding UndoCommand}"
                    IsEnabled="{Binding CanModify}"
                    Style="{StaticResource DrawActionButton}"/>
			<Button Content="▣  Clear All"
                    Command="{Binding ClearCommand}"
                    IsEnabled="{Binding CanModify}"
                    Style="{StaticResource DrawActionButton}"/>
			<Button Content="✓  Finish Polygon"
                    Command="{Binding FinishCommand}"
                    IsEnabled="{Binding CanFinish}"
                    Background="#287A57"
                    BorderBrush="#28976B"
                    FontWeight="SemiBold"
                    Style="{StaticResource DrawActionButton}"/>
			<Button Content="×  Cancel"
                    Command="{Binding CancelCommand}"
                    Background="#B83D49"
                    BorderBrush="#B83D49"
                    Style="{StaticResource DrawActionButton}"/>

			<TextBlock Text="💡  Shortcuts: Backspace (undo) • Enter (finish) • ESC (cancel)"
                       Foreground="#AFC2CDD7"
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       LineHeight="17"
                       Margin="2,2,0,0"/>
		</StackPanel>
	</Border>
</Window>
